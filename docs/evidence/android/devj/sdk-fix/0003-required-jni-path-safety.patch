+// Only the required file-loader and C-to-Java transcript path use these guards.
+// Cleanup operations are permitted while a Java exception remains pending.
+static void revise_check_jni(JNIEnv *env) {
+  if (env->ExceptionCheck()) {
+    throw std::runtime_error("Moonshine JNI operation failed");
+  }
+}
+
+template <typename T> static T revise_jni_value(JNIEnv *env, T value) {
+  revise_check_jni(env);
+  if (value == nullptr) {
+    throw std::runtime_error("Moonshine JNI returned null");
+  }
+  return value;
+}
+
+class ReviseLocalFrame {
+ public:
+  explicit ReviseLocalFrame(JNIEnv *env, jint capacity = 32) : env_(env) {
+    revise_check_jni(env_);
+    if (env_->PushLocalFrame(capacity) != 0) {
+      throw std::runtime_error("Moonshine JNI local frame failed");
+    }
+    if (env_->ExceptionCheck()) {
+      env_->PopLocalFrame(nullptr);
+      throw std::runtime_error("Moonshine JNI local frame failed");
+    }
+  }
+  ~ReviseLocalFrame() { if (active_) env_->PopLocalFrame(nullptr); }
+  ReviseLocalFrame(const ReviseLocalFrame &) = delete;
+  ReviseLocalFrame &operator=(const ReviseLocalFrame &) = delete;
+  jobject keep(jobject result) {
+    active_ = false;
+    return env_->PopLocalFrame(result);
+  }
+ private:
+  JNIEnv *env_;
+  bool active_ = true;
+};
+
+class ReviseUtfChars {
+ public:
+  ReviseUtfChars(JNIEnv *env, jstring value) : env_(env), value_(value) {
+    revise_check_jni(env_);
+    if (value_ != nullptr) {
+      chars_ = env_->GetStringUTFChars(value_, nullptr);
+      // Take ownership before checking: release even if acquisition also
+      // leaves an exception pending, without clearing that exception.
+      if (env_->ExceptionCheck() || chars_ == nullptr) {
+        if (chars_ != nullptr) env_->ReleaseStringUTFChars(value_, chars_);
+        chars_ = nullptr;
+        throw std::runtime_error("Moonshine JNI UTF acquisition failed");
+      }
+    }
+  }
+  ~ReviseUtfChars() {
+    if (chars_ != nullptr) env_->ReleaseStringUTFChars(value_, chars_);
+  }
+  ReviseUtfChars(const ReviseUtfChars &) = delete;
+  ReviseUtfChars &operator=(const ReviseUtfChars &) = delete;
+  const char *get() const { return chars_; }
+ private:
+  JNIEnv *env_;
+  jstring value_;
+  const char *chars_ = nullptr;
+};

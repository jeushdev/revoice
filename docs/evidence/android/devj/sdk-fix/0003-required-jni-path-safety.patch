+static jclass revise_get_class(JNIEnv *env, const char *name) {
+  return revise_jni_value(env, env->FindClass(name));
+}
+static jfieldID revise_get_field(JNIEnv *env, jclass type, const char *name,
+                                const char *signature) {
+  return revise_jni_value(env, env->GetFieldID(type, name, signature));
+}
+static jmethodID revise_get_method(JNIEnv *env, jclass type, const char *name,
+                                  const char *signature) {
+  return revise_jni_value(env, env->GetMethodID(type, name, signature));
+}

+  private static void checkStreamStatus(int status, String operation) {
+    if (status != JNI.MOONSHINE_ERROR_NONE) {
+      throw new RuntimeException("Failed to " + operation + ": " + status);
+    }
+  }
+
+  /**
+   * Requests a pass over accepted audio, bypassing both update interval gates.
+   * Calls/listeners must be serialized by the caller. This neither stops the
+   * stream nor guarantees line completion or a full diarization drain.
+   */
+  public void updateStream(int streamHandle) {
+    long started = System.nanoTime();
+    Transcript transcript = JNI.moonshineTranscribeStream(
+        this.transcriberHandle, streamHandle,
+        JNI.MOONSHINE_FLAG_FORCE_UPDATE | this.transcribeFlags);
+    if (transcript == null) {
+      throw new RuntimeException("Failed to update stream: " + streamHandle);
+    }
+    this.pendingSeconds.put(streamHandle, 0.0);
+    this.lastPassSeconds.put(streamHandle, (System.nanoTime() - started) / 1e9);
+    this.notifyFromTranscript(transcript, streamHandle);
+  }
+
+  /** Requests a pass without changing stream lifetime; not a Pause operation. */
+  public void update() { this.updateStream(this.getDefaultStreamHandle()); }

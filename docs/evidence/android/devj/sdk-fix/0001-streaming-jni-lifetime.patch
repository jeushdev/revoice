+    if (!audio_data_ptr || env->ExceptionCheck()) {
+      return MOONSHINE_ERROR_UNKNOWN;
+    }
     return moonshine_transcribe_add_audio_to_stream(
-        transcriber_handle, stream_handle, audio_data_ptr, audio_data_size,
-        sample_rate, flags);
+        transcriber_handle, stream_handle, audio_data_ptr.get(),
+        static_cast<size_t>(audio_data_size), sample_rate, flags);
   } catch (const std::exception &e) {
     ALOGE("moonshineAddAudioToStream: %s\n", e.what());
     return MOONSHINE_ERROR_UNKNOWN;
+  } catch (...) {
+    // No C++ exception may escape a JNI boundary, including non-std exceptions.
+    ALOGE("moonshineAddAudioToStream: unknown native exception\n");
+    return MOONSHINE_ERROR_UNKNOWN;
   }
 }

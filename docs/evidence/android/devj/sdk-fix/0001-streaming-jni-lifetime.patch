diff --git a/language-bindings/android/moonshine-jni/moonshine-jni.cpp b/language-bindings/android/moonshine-jni/moonshine-jni.cpp
--- a/language-bindings/android/moonshine-jni/moonshine-jni.cpp
+++ b/language-bindings/android/moonshine-jni/moonshine-jni.cpp
@@ -646,14 +646,37 @@
   try {
-    if (audio_data == nullptr) {
+    // Preserve any pending Java exception, including an allocation failure.
+    if (env->ExceptionCheck()) {
+      return MOONSHINE_ERROR_UNKNOWN;
+    }
+    if (audio_data == nullptr || sample_rate <= 0) {
       return MOONSHINE_ERROR_INVALID_ARGUMENT;
     }
-    float *audio_data_ptr = env->GetFloatArrayElements(audio_data, nullptr);
-    size_t audio_data_size = env->GetArrayLength(audio_data);
+    // Validate length before acquiring storage. Empty audio is not a flush API.
+    const jsize audio_data_size = env->GetArrayLength(audio_data);
+    if (env->ExceptionCheck()) {
+      return MOONSHINE_ERROR_UNKNOWN;
+    }
+    if (audio_data_size <= 0) {
+      return MOONSHINE_ERROR_INVALID_ARGUMENT;
+    }
+    auto release_audio = [env, audio_data](jfloat *samples) {
+      env->ReleaseFloatArrayElements(audio_data, samples, JNI_ABORT);
+    };
